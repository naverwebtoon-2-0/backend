# ops/secrets.env로 복사해 값을 채운다 (커밋 금지). render-init-script.sh가 서버 환경변수에 덮어쓴다.
# 비워 둔 항목은 넣지 않아도 된다. DB 비밀번호·JWT_SECRET은 서버에서 무작위로 만든다.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
AUTHOR_INVITE_CODES=choose-an-invite-code

# Naver Object Storage를 쓰려면 STORAGE_BACKEND=s3와 키를 함께 넣는다
STORAGE_BACKEND=s3
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# CLOVA를 쓰려면 AI_BACKEND=clova와 키를 함께 넣는다
AI_BACKEND=clova
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
CLOVA_STUDIO_API_KEY=
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
