[Unit]
Description=naverwebtoon 2.0 backend (docker compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/opt/naverwebtoon-backend/current/docker-compose.prod.yml

[Service]
Type=oneshot
RemainAfterExit=true
Environment=DOCKER_CONFIG=/opt/naverwebtoon-backend/.docker
Environment=DB_INIT_DIR=/opt/naverwebtoon-backend/db-init
WorkingDirectory=/opt/naverwebtoon-backend/current
ExecStart=/usr/local/sbin/naverwebtoon-backend-compose up -d --remove-orphans
ExecStop=/usr/local/sbin/naverwebtoon-backend-compose stop
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
