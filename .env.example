# 복사해서 .env로 쓴다. 실제 비밀값은 커밋하지 않는다.
APP_ENV=development
LOG_LEVEL=INFO

# docker compose용 DB 비밀번호 (DATABASE_URL은 compose가 역할별로 만든다)
POSTGRES_PASSWORD=change-me-postgres
NW_OWNER_PASSWORD=change-me-owner
NW_APP_PASSWORD=change-me-app
# compose 밖에서 직접 실행할 때만 사용
# DATABASE_URL=postgresql+psycopg://nw_app:change-me-app@127.0.0.1:5432/naverwebtoon

# 인증
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
AUTHOR_INVITE_CODES=invite-code-1,invite-code-2
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://127.0.0.1:8080

# 외부 연동: fake | clova, fake | s3
AI_BACKEND=fake
STORAGE_BACKEND=fake

# Naver Object Storage (STORAGE_BACKEND=s3)
STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
STORAGE_REGION=kr-standard
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# CLOVA (AI_BACKEND=clova)
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
CLOVA_STUDIO_URL=https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005
CLOVA_STUDIO_API_KEY=
CLOVA_DUBBING_URL=
CLOVA_DUBBING_CLIENT_ID=
CLOVA_DUBBING_CLIENT_SECRET=

# 제한·쿼터
MAX_IMAGE_BYTES=20971520
MAX_IMAGES_PER_EPISODE=100
QUOTA_DUBBING_CHARS=100000
QUOTA_OCR_IMAGES=500
LOW_OCR_CONFIDENCE_THRESHOLD=0.8
